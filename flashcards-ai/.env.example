# Copiar como .env (Docker Compose lo lee solo) o .env.local (npm run dev).
# Nunca subir el archivo con valores reales.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secreta: solo la usa el worker. Nunca exponerla en el navegador ni en Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel AI Gateway (texto). Sin esta clave el worker igual indexa los
# materiales, pero no genera tarjetas iniciales ni contenido con IA.
AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=nvidia/nemotron-3.5-lightning-free

# RabbitMQ. En Docker Compose se reemplaza por el broker local.
# En la nube usar la URL AMQPS de CloudAMQP: amqps://usuario:clave@host/vhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Solo en Vercel: URL pública del worker en Render, sin credenciales.
# La pantalla de materiales la visita para despertarlo si se durmió.
# NEXT_PUBLIC_WORKER_WAKE_URL=https://flashcards-worker.onrender.com
